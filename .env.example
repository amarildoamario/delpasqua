# Connessione remota: sola lettura da locale, anche con next build/next start.
DATABASE_URL="postgresql://readonly_user:password@host:5432/database?sslmode=require"
DIRECT_URL="postgresql://readonly_user:password@host:5432/database?sslmode=require"

# Per scrivere durante lo sviluppo: Postgres separato su loopback.
# Sono consentiti solo i nomi delpasqua_dev e delpasqua_test.
# LOCAL_DATABASE_URL="postgresql://dev_user:password@127.0.0.1:5432/delpasqua_dev"
# Per l’istanza locale gestita da Prisma dev, abilita anche:
# LOCAL_DATABASE_PROVIDER="prisma-dev"

# IVA
VAT_RATE=0.04
PRICES_INCLUDE_VAT=false

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_LIVEMODE_EXPECTED=false

# Canonical site URL
NEXT_PUBLIC_SITE_URL="https://example.com"
SITE_URL="https://example.com"

# App URL (dev)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# durata session admin (secondi)
ADMIN_SESSION_TTL_SECONDS=28800

# rotazione session (secondi)
ADMIN_SESSION_ROTATE_SECONDS=900

# per check Origin/Referer (prod)
APP_ORIGIN="https://example.com"

# Resend
RESEND_API_KEY="re_..."
EMAIL_FROM="Del Pasqua <noreply@tuodominio.it>"
EMAIL_REPLY_TO="tuo@email.it"
EMAIL_NOTIFY="tuo@email.it"
ADMIN_NOTIFY_EMAIL="tuo@email.it"

# Report admin
ANALYTICS_DB_ENABLED=true
REPORT_SECRET="supersegreto"

# Upstash Redis (rate limit distribuito)
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# Admin credentials (metti valori veri solo nel tuo .env locale)
ADMIN_EMAIL="admin@tuodominio.it"
ADMIN_PASSWORD="cambia-questa-password"
ADMIN_SESSION_SECRET="genera-una-stringa-lunga-casuale"
